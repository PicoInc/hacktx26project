# Copy to frontend/.env.local to change these (it's gitignored).

# true = use the bundled sample JSON instead of the Flask API (no backend needed)
VITE_USE_SAMPLE=false

# Where Vite forwards /api. Default: http://127.0.0.1:5000 (flask run).
# macOS with AirPlay Receiver on: run `flask run --port 5001` and set this to http://127.0.0.1:5001
VITE_API_PROXY=
